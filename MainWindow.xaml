<Window x:Class="DynamicNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicNotch" Width="520" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Notch" Background="Black" CornerRadius="0,0,14,14"
                Width="180" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                ClipToBounds="True" MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Compact: tiny music glyph when something is playing -->
                <Grid x:Name="CompactView">
                    <TextBlock x:Name="CompactIcon" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#1ED760" FontSize="13" Margin="18,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- Expanded: media + quick glance + clipboard -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="20,16,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ArtBorder" Grid.Column="0" Width="60" Height="60" CornerRadius="10" Background="#222"/>

                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White"
                                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" Text="" Foreground="#999" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click"/>
                            <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" Click="Play_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <TextBlock x:Name="TimeText" Foreground="White" FontSize="26" FontWeight="Light"/>
                            <TextBlock x:Name="DateText" Foreground="#999" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BatteryText" Foreground="#9BE3A8" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CLIPBOARD" Foreground="#666" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="ClipList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1A1A" CornerRadius="6" Padding="8,3" Margin="0,0,0,3"
                                                Cursor="Hand" MouseLeftButtonUp="ClipItem_Click">
                                            <TextBlock Text="{Binding Preview}" Foreground="#CCC" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Activity: transient live-activity pill -->
                <Grid x:Name="ActivityView" Visibility="Collapsed" Margin="18,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ActivityIcon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActivityText" Foreground="White" FontSize="13"
                                   MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="ActivityBar" Width="60" Height="4" Margin="12,0,0,0"
                                     Minimum="0" Maximum="100" Foreground="White" Background="#333"
                                     BorderThickness="0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
